{
  "name": "austral/elastic-search-bundle",
  "type": "symfony-bundle",
  "description": "Austral Elastic Search Bundle",
  "keywords": [
    "Austral",
    "Elastic Search",
    "Symfony"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Matthieu Beurel",
      "email": "matthieu@austral.dev",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.4 <9.0",
    "austral/contracts": "^4.0",
    "austral/tools-bundle": "^4.0",
    "austral/entity-bundle": "^4.0",
    "doctrine/collections": "^2.2 || ^3.1",
    "doctrine/orm": "^3.7",
    "doctrine/persistence": "^3.3 || ^4.0",
    "doctrine/doctrine-bundle": "^3.2.2",
    "doctrine/event-manager": "^2.1.1",
    "symfony/validator": "^7.4",
    "symfony/dependency-injection": "^7.4",
    "symfony/http-foundation": "^7.4",
    "symfony/console": "^7.4",
    "symfony/config": "^7.4",
    "symfony/http-kernel": "^7.4",
    "symfony/http-client": "^7.4",
    "symfony/event-dispatcher": "^7.4",
    "symfony/event-dispatcher-contracts": "^3.5",
    "elasticsearch/elasticsearch": "^8.19 || ^9.1",
    "monolog/monolog": "^3.4",
    "nyholm/psr7": "^1.8"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": "^11.5"
  },
  "suggest": {
    "austral/admin-bundle": "^4.0",
    "austral/website-bundle": "^4.0"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "Austral\\ElasticSearchBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Austral\\ElasticSearchBundle\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
