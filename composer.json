{
    "name": "austral/elastic-search-bundle",
    "type": "symfony-bundle",
    "description": "Austral Elastic Search Bundle",
    "keywords": [
        "Austral",
        "Elastic Search",
        "Symfony"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Matthieu Beurel",
            "email": "matthieu@austral.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2 <9.0",
        "austral/contracts": "^4.0",
        "austral/tools-bundle": "^4.0",
        "austral/entity-bundle": "^4.0",
        "symfony/config": "^7.4",
        "symfony/event-dispatcher": "^7.4",
        "elasticsearch/elasticsearch": "^v9.1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0"
    },
    "suggest": {
        "austral/admin-bundle": "^4.0",
        "austral/website-bundle": "^4.0"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Austral\\ElasticSearchBundle\\": ""
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
